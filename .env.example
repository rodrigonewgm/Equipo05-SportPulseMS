# API-Football (RapidAPI) — https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=your_rapidapi_key_here

# JWT Secret — Clave compartida entre todos los microservicios
JWT_SECRET=sportpulse-secret-key-change-this-in-production

# (Opcional) Ajustar tiempo de expiración del token JWT en milisegundos (default: 3600000 = 1 hora)
# JWT_EXPIRATION=3600000
